  "nativePerformanceUpdaterFindings": [
    {
      "key": "launchAgentScan",
      "statement": "Consumes injected scan locations, enumerates with FileManager options argument 1, collects plist-extension entries, checks pause/cancel and maps them. Mapping applies an injected ignore predicate, asks startupApplicationPathFor:accurate:, then builds models and increments progress.",
      "evidenceIds": [
        "ev_5d3921678b27d62696ed6e9ba3dc693a45f156034ee88353711b569566dceb9e",
        "ev_76b26597a0df767f407a2e524e9df3a8d804adf8979a4fed9e2ccb1771f7a544"
      ],
      "addresses": [
        "0x3530",
        "0x3d7c"
      ]
    },
    {
      "key": "legacyLoginItemScan",
      "statement": "Calls injected manager validLoginItemsList, derives total progress, checks pause/cancel and maps listed entries through helper 0x47d4. The manager implementation was not followed.",
      "evidenceIds": [
        "ev_a8e484ded4449fb21166c56b7540b9eb8181c6bc88a033fab7635ce3f264cb5b"
      ],
      "addresses": [
        "0x45d4",
        "0x47d4"
      ]
    },
    {
      "key": "maintenanceScanBoundary",
      "statement": "Generic execute sets total work to one, delegates through an injected model-factory/protocol witness, then completes one work unit. RAM factory returns a generic MaintenanceScanTask<FreeUpRAMTaskModel>? through construction helper 0x23c8; the recovered generic construction body has no eligibility branch. This establishes a constructible scan/model path, not an executed maintenance action.",
      "evidenceIds": [
        "ev_32ab073d2b26cc9d7074418cd16e283a7be494b51cf2cddf53d8a09a8fdee363",
        "ev_7faf68ac1cc9d779fa1e1782fbcb24a7869bd6c66a289177dae74e8ad11b69a7",
        "ev_5e7eecc6ca40e793e66ea110189779a5ae4cd2d8c938b4f0e0bdd8c3b1609448"
      ],
      "addresses": [
        "0x1e10",
        "0x2208",
        "0x23c8"
      ]
    },
    {
      "key": "maintenanceNameInventory",
      "statement": "Procedure inventory has factories named FreeUpRAM, PeriodicScripts, FlushDNSCache, SpeedUpMail, RepairDiskPermissions, ReindexSpotlight, ThinLocalSnapshots and FreeUpPurgeableSpace. Except the RAM factory/generic construction path, these were not individually decompiled; names do not establish enabled features.",
      "evidenceIds": [
        "ev_9b0e81bfe25c4bca9143f63426f42a17b1091550f0af3fb26e6530569bc99601"
      ],
      "addresses": []
    },
    {
      "key": "updaterSourceSelection",
      "statement": "Factory has two option-bit branches controlling candidate-provider inclusion and constructs the app-update scan using metadata, providers and an injected network service. One provider construction reads NSProcessInfo operatingSystemVersion. Static metadata declares MASApplicationsDataSource and SparkleApplicationsDataSource conformances, without proving they are selected by a live module.",
      "evidenceIds": [
        "ev_23ea851fd682dc52fac05af47fdcb03e683742420b559bcb8e48bd87eaf3c2b5",
        "ev_bd406dda32851079e12409e51ce149a07b8c43800536a30aa8f30f60a053b917"
      ],
      "addresses": [
        "0x3450"
      ]
    },
    {
      "key": "appUpdateScan",
      "statement": "Collects arrays from injected candidate providers, combines/filters via 0x7ef8, checks pause/cancel, invokes an injected update-network service, handles failed result by throwing, and progresses through candidate/response processing. It builds a local dictionary using bundleID plus appstore or sparkle source strings.",
      "evidenceIds": [
        "ev_4be368aae9c9906f0f1dc1dc7be6649a9c10e0cdad298e3dad7ba38b5d1e24bb"
      ],
      "addresses": [
        "0x8130",
        "0x7ef8"
      ]
    },
    {
      "key": "updateResponseCorrelation",
      "statement": "For each received result, looks up the local-candidate dictionary by result identifier plus source. Missing matches become nil and are omitted. Matched records go to model construction. A final injected predicate filters reconciled models; exact predicate implementation is untraced.",
