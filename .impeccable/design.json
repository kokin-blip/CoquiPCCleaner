  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Main analysis action. Preview contains no device readings.",
      "html": "<button class=\"ds-primary\">Analyze System</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:32px;padding:6px 12px;border:1px solid var(--border);border-radius:6px;cursor:pointer;transition:background .13s ease,border-color .13s ease;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:13px;line-height:1.5;background:var(--accent);color:var(--on-accent);border-color:transparent;font-weight:600;}.ds-primary:hover{filter:brightness(1.06);}.ds-primary:active{background:var(--accent);}.ds-primary:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}.ds-primary:disabled{opacity:.5;cursor:default;}@media(prefers-reduced-motion:reduce){.ds-primary{transition:none;}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Retry and other secondary actions.",
      "html": "<button class=\"ds-secondary\">Retry monitoring</button>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:32px;padding:6px 12px;border:1px solid var(--border);border-radius:6px;cursor:pointer;transition:background .13s ease,border-color .13s ease;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:13px;line-height:1.5;background:var(--elevated);color:var(--text);}.ds-secondary:hover{background:var(--hover);}.ds-secondary:active{background:var(--selected);}.ds-secondary:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}.ds-secondary:disabled{opacity:.5;cursor:default;}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none;}}"
    },
    {
      "name": "Destructive Confirmation Button",
      "kind": "button",
      "refersTo": "button-danger",
      "description": "Explicit confirmation for helper-record, helper or local-history removal. Illustrative preview grants no operation authority.",
      "html": "<button class=\"ds-danger\">Remove helper records</button>",
      "css": ".ds-danger{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:32px;padding:6px 12px;border:1px solid transparent;border-radius:6px;cursor:pointer;transition:background .13s ease,border-color .13s ease;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:13px;line-height:1.5;background:var(--danger);color:var(--on-danger);}.ds-danger:hover,.ds-danger:active{background:var(--danger);}.ds-danger:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}.ds-danger:disabled{opacity:.5;cursor:default;}@media(prefers-reduced-motion:reduce){.ds-danger{transition:none;}}"
    },
    {
      "name": "Text Button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Evidence and deeper inspection links.",
      "html": "<button class=\"ds-text\">View evidence</button>",
      "css": ".ds-text{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:32px;padding:6px 12px;border:1px solid var(--border);border-radius:6px;cursor:pointer;transition:background .13s ease,border-color .13s ease;font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:13px;line-height:1.5;background:transparent;color:var(--accent-text);padding:4px 0;min-height:28px;border:0;justify-content:flex-start;}.ds-text:hover,.ds-text:active{background:transparent;}.ds-text:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Labeled file-filter field.",
      "html": "<input class=\"ds-search\" type=\"search\" aria-label=\"Filter files\" placeholder=\"Filter this page…\">",
      "css": ".ds-search{font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:13px;line-height:1.5;min-height:32px;padding:6px 10px;border:1px solid var(--border);border-radius:6px;background:var(--input);color:var(--text);max-width:100%;}.ds-search::placeholder{color:var(--secondary);}.ds-search:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}"
    },
    {
      "name": "Selected Navigation",
      "kind": "nav",
      "refersTo": "navigation-selected",
      "description": "Current page in the grouped sidebar.",
      "html": "<nav aria-label=\"Preview navigation\"><button class=\"ds-nav\" aria-current=\"page\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>Dashboard</button></nav>",
      "css": ".ds-nav{font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;font-size:13px;line-height:1.5;display:flex;align-items:center;gap:10px;min-height:36px;width:100%;padding:8px 10px;border:0;border-radius:7px;background:var(--selected);color:var(--text);font-size:12px;text-align:left;cursor:pointer;}.ds-nav svg{color:var(--accent-text);}.ds-nav:hover{background:var(--selected);}.ds-nav:active{background:var(--selected);}.ds-nav:focus-visible{outline:3px solid var(--focus);outline-offset:3px;}"
    },
    {
      "name": "Neutral Status",
